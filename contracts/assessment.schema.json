{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintest.vault.internal/contracts/assessment.schema.json",
  "title": "ScintestVerificationAssessment",
  "description": "Schema for deterministic verification findings and assessments generated by VAULT.",
  "type": "object",
  "required": [
    "assessment_id",
    "record_id",
    "status",
    "abstain",
    "issues",
    "evidence",
    "derived",
    "engine_version",
    "created_at"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "description": "Unique assessment UUID or identifier (e.g. ASM-0001)."
    },
    "record_id": {
      "type": "string",
      "description": "Referenced raw experiment record identifier."
    },
    "supersedes_id": {
      "type": ["string", "null"],
      "description": "Assessment ID this finding supersedes if this is a retrospective correction."
    },
    "status": {
      "type": "string",
      "enum": ["checks_passed", "flagged", "needs_review"],
      "description": "High-level verification status for downstream ingestion."
    },
    "verdict": {
      "type": "string",
      "enum": ["valid", "invalid", "needs_review"],
      "description": "Deterministic scientific ground truth verdict."
    },
    "abstain": {
      "type": "boolean",
      "description": "True if engine abstains from a definitive pass/fail verdict due to ambiguity or missing evidence."
    },
    "original_verdict": {
      "type": ["string", "null"],
      "description": "Originally claimed analyst verdict preserved from source record."
    },
    "issues": {
      "type": "array",
      "description": "List of explicit failure or review reason codes encountered.",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "description": "Detailed calculation evidence and audit traces for each rule evaluated.",
      "items": {
        "type": "object",
        "required": ["rule_name", "status"],
        "properties": {
          "rule_name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "needs_review"] },
          "reason": { "type": ["string", "null"] },
          "details": { "type": ["object", "string"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "derived": {
      "type": "object",
      "description": "Recomputed normalized values, canonical units, converted timestamps, and margins.",
      "properties": {
        "normalized_value": { "type": ["number", "null"] },
        "canonical_unit": { "type": ["string", "null"] },
        "specification_limits": {
          "type": "object",
          "properties": {
            "min": { "type": ["number", "null"] },
            "max": { "type": ["number", "null"] },
            "unit": { "type": ["string", "null"] }
          }
        },
        "holding_time_hours": { "type": ["number", "null"] },
        "max_holding_hours": { "type": ["number", "null"] },
        "instrument_status": { "type": ["string", "null"] },
        "lot_status": { "type": ["string", "null"] },
        "sop_status": { "type": ["string", "null"] }
      }
    },
    "engine_version": {
      "type": "string",
      "description": "Version string of the deterministic verification engine (e.g. 2.0.0)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when this assessment was generated."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when this assessment was appended to the immutable ledger."
    },
    "reviewer_state": {
      "type": "string",
      "enum": ["automated", "human_review_pending", "human_approved", "human_disputed"],
      "description": "Lifecycle state of the assessment."
    }
  },
  "additionalProperties": false
}
